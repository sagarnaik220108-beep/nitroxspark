# =============================================================================
# Sentinel AI - Environment Configuration
# Copy this file to .env.local and fill in your credentials.
# =============================================================================

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase (PostgreSQL + Google OAuth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: AI / LLM Provider for deep semantic explanations & custom patch synthesis
# If omitted, Sentinel AI runs with its deterministic static & heuristic security engine.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=

# Security & Rate Limiting
SCAN_RATE_LIMIT_MAX=30
SCAN_RATE_LIMIT_WINDOW_MS=60000
MAX_CODE_SIZE_BYTES=262144
